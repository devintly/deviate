{
  "manifest_version": 3,
  "default_locale": "ru",
  "name": "__MSG_extensionName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "deviateproxy@devintly",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "incognito": "spanning",
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "alarms",
    "webRequest",
    "webRequestBlocking",
    "unlimitedStorage",
    "dns"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "ws://*/*",
    "wss://*/*"
  ],
  "icons": {
    "32": "icons/icon_32.png",
    "64": "icons/icon_64.png",
    "128": "icons/icon_128.png",
    "256": "icons/icon_256.png"
  },
  "background": {
    "scripts": ["pac-parse.js", "list-update.js", "list-ingest.js", "host-rules.js", "proxy-config.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeviateProxy",
    "default_icon": {
      "32": "icons/icon_32.png",
      "64": "icons/icon_64.png",
      "128": "icons/icon_128.png",
      "256": "icons/icon_256.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
