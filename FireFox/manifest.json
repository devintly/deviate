{
  "manifest_version": 3,
  "name": "meguproxy-fork",
  "version": "1.3",
  "description": "Форк MeguProxy: управление проксированием сайтов по правилам средствами SOCKS/HTTP, а также фильтрация от трекеров средствами списков.",
  "browser_specific_settings": {
    "gecko": {
      "id": "meguproxy-fork@devintly",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "incognito": "spanning",
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "alarms",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "64": "icon.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "meguproxy-fork",
    "default_icon": {
      "64": "icon.png"
    }
  }
}
