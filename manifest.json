{
  "manifest_version": 3,
  "name": "DeviateProxy",
  "version": "1.11.0",
  "description": "DeviateProxy — обход блокировок: проксирование сайтов по правилам средствами SOCKS/HTTP.",
  "browser_specific_settings": {
    "gecko": {
      "id": "deviateproxy@devintly",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "incognito": "spanning",
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "alarms",
    "webRequest",
    "webRequestBlocking",
    "unlimitedStorage",
    "dns"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "ws://*/*",
    "wss://*/*"
  ],
  "icons": {
    "48": "icon.png",
    "96": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "scripts": ["pac-parse.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeviateProxy",
    "default_icon": {
      "48": "icon.png",
      "96": "icon.png",
      "128": "icon.png"
    }
  }
}